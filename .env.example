# Environment variables for Cartovum Bulk Product Manager.
# Copy to .env for "npm run start" outside the Shopify CLI. During "npm run dev" the Shopify CLI sets
# SHOPIFY_API_KEY, SHOPIFY_API_SECRET, SHOPIFY_APP_URL and SCOPES itself.
# Never commit real values. .env and .env.* are git-ignored; only this example is tracked.

# Dev Dashboard > Cartovum Bulk Product Manager > Settings > Client credentials.
# The client ID is public; the client secret is a secret.
SHOPIFY_API_KEY=your-client-id
SHOPIFY_API_SECRET=your-client-secret

# The app's public origin, no path. Planned production value: https://app.cartovumagency.com
# Must match application_url in shopify.app.production.toml. The OAuth redirect URL is this + /auth/callback.
# Production requires https (plain http is accepted only for localhost); the server refuses to start otherwise.
SHOPIFY_APP_URL=https://app.cartovumagency.com

# Must match [access_scopes] in shopify.app*.toml. See ACCESS_SCOPES.md.
SCOPES=write_products,write_inventory

# Webhook HMACs are verified with SHOPIFY_API_SECRET; there is no separate webhook secret.

# Production database (PostgreSQL). Development uses prisma/dev.sqlite; see README, "Production database".
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/cartovum

NODE_ENV=production
PORT=3000

# "off" makes a process serve requests only; at least one process must run the worker.
CARTOVUM_WORKER=on

# Optional: the store's custom admin domain, if it uses one.
# SHOP_CUSTOM_DOMAIN=
