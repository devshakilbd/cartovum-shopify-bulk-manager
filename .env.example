# Copy to .env for "npm run start" outside the Shopify CLI. The CLI ("npm run dev") provides these itself.
# Never commit real values.

# From the Partner Dashboard (Apps > your app > Client credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public HTTPS URL of this app
SHOPIFY_APP_URL=https://your-app.example.com

# Must match access_scopes in shopify.app.toml
SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations

# Webhook HMACs are verified with SHOPIFY_API_SECRET; there is no separate webhook secret.

# Production database. Development uses prisma/dev.sqlite (see README, "Production database").
DATABASE_URL=postgresql://user:password@host:5432/cartovum

NODE_ENV=production
PORT=3000

# Set to "off" to run a web-only process (another process must then run the worker).
CARTOVUM_WORKER=on
